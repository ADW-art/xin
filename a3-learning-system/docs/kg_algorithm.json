{
  "domain": "algorithm",
  "name": "数据结构与算法",
  "cs2023_area": "AL",
  "description": "从线性结构到图论算法思想的完整知识体系，4层递进设计",
  "version": "2.0",
  "phases": [
    {"id": "foundation", "name": "基础结构", "order": 1, "blooms": "remember/understand"},
    {"id": "core", "name": "核心结构", "order": 2, "blooms": "apply"},
    {"id": "advanced", "name": "高级算法思想", "order": 3, "blooms": "analyze/evaluate"},
    {"id": "practice", "name": "综合应用", "order": 4, "blooms": "create"}
  ],
  "nodes": [
    {"id": "algo:complexity", "name": "算法复杂度分析", "phase": "foundation", "difficulty": 2, "blooms": "understand", "hours": 4, "description": "时间复杂度、空间复杂度、大O表示法、最好/最坏/平均情况分析", "keywords": ["复杂度", "大O", "时间复杂度", "空间复杂度", "算法分析"]},
    {"id": "algo:array", "name": "数组与动态数组", "phase": "foundation", "difficulty": 1, "blooms": "apply", "hours": 3, "description": "静态数组、动态数组、随机访问、插入删除复杂度", "keywords": ["数组", "动态数组", "Array", "随机访问"]},
    {"id": "algo:linkedlist", "name": "链表", "phase": "foundation", "difficulty": 2, "blooms": "apply", "hours": 4, "description": "单链表、双向链表、循环链表、哨兵节点、链表操作", "keywords": ["链表", "单链表", "双向链表", "LinkedList", "ListNode"]},
    {"id": "algo:stack", "name": "栈", "phase": "foundation", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "栈LIFO特性、顺序栈/链栈、括号匹配、表达式求值", "keywords": ["栈", "Stack", "LIFO", "后进先出", "括号匹配"]},
    {"id": "algo:queue", "name": "队列", "phase": "foundation", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "队列FIFO特性、循环队列、双端队列Deque、优先队列概念", "keywords": ["队列", "Queue", "FIFO", "双端队列", "Deque", "优先队列"]},
    {"id": "algo:hashtable", "name": "哈希表", "phase": "core", "difficulty": 3, "blooms": "apply", "hours": 4, "description": "哈希函数设计、冲突解决(链地址/开放地址)、负载因子、Java HashMap/Python dict原理", "keywords": ["哈希", "Hash", "散列", "HashMap", "字典", "冲突解决"]},
    {"id": "algo:binarytree", "name": "二叉树", "phase": "core", "difficulty": 3, "blooms": "apply", "hours": 5, "description": "二叉树定义与性质、遍历(前/中/后/层序)、递归与非递归实现", "keywords": ["二叉树", "遍历", "前序", "中序", "后序", "层序遍历", "BST"]},
    {"id": "algo:bst", "name": "二叉搜索树BST", "phase": "core", "difficulty": 3, "blooms": "apply", "hours": 4, "description": "BST性质、插入/删除/查找操作、中序遍历有序性、最坏情况退化", "keywords": ["BST", "二叉搜索树", "二叉查找树", "插入", "删除", "搜索"]},
    {"id": "algo:balancedtree", "name": "平衡树", "phase": "advanced", "difficulty": 4, "blooms": "analyze", "hours": 5, "description": "AVL树旋转操作(LL/RR/LR/RL)、红黑树5条性质与插入修复、B树/B+树用于数据库索引", "keywords": ["AVL", "红黑树", "平衡树", "旋转", "B树", "B+树", "自平衡"]},
    {"id": "algo:heap", "name": "堆与优先队列", "phase": "core", "difficulty": 3, "blooms": "apply", "hours": 4, "description": "二叉堆(最大堆/最小堆)、堆化操作、堆排序、优先队列API、TopK问题", "keywords": ["堆", "Heap", "堆排序", "优先队列", "TopK", "最大堆", "最小堆"]},
    {"id": "algo:graph_basic", "name": "图基础", "phase": "core", "difficulty": 3, "blooms": "understand", "hours": 3, "description": "图的基本概念(顶点/边/度)、邻接矩阵/邻接表表示、有向图/无向图/加权图", "keywords": ["图", "Graph", "邻接矩阵", "邻接表", "有向图", "无向图", "顶点", "边"]},
    {"id": "algo:graph_traversal", "name": "图的遍历", "phase": "core", "difficulty": 3, "blooms": "apply", "hours": 4, "description": "DFS深度优先搜索(递归+栈)、BFS广度优先搜索(队列)、连通分量、拓扑排序", "keywords": ["DFS", "BFS", "深度优先", "广度优先", "拓扑排序", "图遍历"]},
    {"id": "algo:shortest_path", "name": "最短路径算法", "phase": "advanced", "difficulty": 4, "blooms": "analyze", "hours": 5, "description": "Dijkstra算法(贪心)、Bellman-Ford算法、Floyd-Warshall全源最短路径、A*启发式搜索", "keywords": ["最短路径", "Dijkstra", "Bellman-Ford", "Floyd", "A*", "SPFA"]},
    {"id": "algo:mst", "name": "最小生成树", "phase": "advanced", "difficulty": 4, "blooms": "analyze", "hours": 3, "description": "Prim算法、Kruskal算法(并查集)、MST性质与应用场景", "keywords": ["最小生成树", "MST", "Prim", "Kruskal", "并查集", "Union Find"]},
    {"id": "algo:sort_basic", "name": "基础排序算法", "phase": "foundation", "difficulty": 2, "blooms": "apply", "hours": 5, "description": "冒泡排序O(n²)、选择排序、插入排序、希尔排序，理解简单排序的稳定性与适用场景", "keywords": ["排序", "冒泡", "选择排序", "插入排序", "希尔排序", "O(n²)", "稳定排序"]},
    {"id": "algo:sort_advanced", "name": "高级排序算法", "phase": "core", "difficulty": 3, "blooms": "analyze", "hours": 5, "description": "快速排序(分区+递归)、归并排序(分治+合并)、堆排序，平均O(nlogn)对比分析", "keywords": ["快速排序", "归并排序", "堆排序", "O(nlogn)", "分区", "分治", "QuickSort", "MergeSort"]},
    {"id": "algo:binary_search", "name": "二分查找", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "二分查找模板(左闭右闭/左闭右开)、变体(查找第一个/最后一个)、旋转数组查找", "keywords": ["二分", "BinarySearch", "二分查找", "折半查找", "二分搜索"]},
    {"id": "algo:recursion", "name": "递归与回溯", "phase": "advanced", "difficulty": 3, "blooms": "analyze", "hours": 5, "description": "递归三要素(终止条件/递推公式/返回值)、回溯框架(选择→递归→撤销)、N皇后/全排列/组合", "keywords": ["递归", "回溯", "DFS", "N皇后", "全排列", "组合", "剪枝"]},
    {"id": "algo:divide_conquer", "name": "分治思想", "phase": "advanced", "difficulty": 3, "blooms": "analyze", "hours": 3, "description": "分治三步骤(分解→解决→合并)、主定理分析复杂度、典型应用(归并排序/快速排序/最近点对)", "keywords": ["分治", "Divide", "Conquer", "主定理", "归并", "分解"]},
    {"id": "algo:dp", "name": "动态规划", "phase": "advanced", "difficulty": 4, "blooms": "evaluate", "hours": 8, "description": "最优子结构+无后效性、状态定义与转移方程、经典问题(背包/最长公共子序列/编辑距离/矩阵链乘)", "keywords": ["动态规划", "DP", "状态转移", "背包", "LCS", "编辑距离", "最优子结构", "记忆化"]},
    {"id": "algo:greedy", "name": "贪心算法", "phase": "advanced", "difficulty": 3, "blooms": "analyze", "hours": 3, "description": "贪心选择性质、最优子结构证明、典型应用(活动选择/霍夫曼编码/区间调度)", "keywords": ["贪心", "Greedy", "贪心选择", "霍夫曼", "区间调度", "活动选择"]},
    {"id": "algo:two_pointer", "name": "双指针与滑动窗口", "phase": "practice", "difficulty": 3, "blooms": "apply", "hours": 4, "description": "快慢指针(环检测/中点)、左右指针(有序数组/三数之和)、滑动窗口(最长无重复子串/最小覆盖子串)", "keywords": ["双指针", "滑动窗口", "快慢指针", "左右指针", "窗口", "two pointer"]},
    {"id": "algo:string_algo", "name": "字符串算法", "phase": "practice", "difficulty": 4, "blooms": "apply", "hours": 4, "description": "KMP模式匹配、Rabin-Karp哈希匹配、Trie字典树、最长回文子串Manacher", "keywords": ["字符串", "KMP", "Trie", "字典树", "模式匹配", "回文", "前缀树"]},
    {"id": "algo:bit", "name": "位运算技巧", "phase": "practice", "difficulty": 3, "blooms": "apply", "hours": 3, "description": "与/或/异或/移位运算、常见位操作(判断奇偶/交换/去重)、状态压缩DP思想", "keywords": ["位运算", "bit", "异或", "移位", "状态压缩", "位操作"]},
    {"id": "algo:leetcode", "name": "算法刷题方法论", "phase": "practice", "difficulty": 3, "blooms": "create", "hours": 6, "description": "题型分类训练(数组/链表/树/DP/图/回溯)、复杂度估算技巧、面试常见模式、调试技巧", "keywords": ["LeetCode", "刷题", "面试", "题型", "分类", "模式", "调试"]}
  ],
