    {"id": "py:basic", "name": "Python基础", "phase": "foundation", "difficulty": 1, "blooms": "remember/understand", "hours": 2, "description": "Python语言入门总览：语法特点、开发环境、基本编程概念", "keywords": ["Python基础", "Python入门", "Python语法", "Python简介", "编程入门"]},
    {"id": "py:env", "name": "Python环境搭建", "phase": "foundation", "difficulty": 1, "blooms": "apply", "hours": 2, "description": "安装Python解释器、配置IDE与虚拟环境", "keywords": ["Python安装", "环境配置", "IDE", "venv", "pip"]},
    {"id": "py:var", "name": "变量与数据类型", "phase": "foundation", "difficulty": 1, "blooms": "understand", "hours": 3, "description": "变量命名、数字/字符串/布尔类型、类型转换", "keywords": ["变量", "数据类型", "int", "str", "bool", "float", "type"]},
    {"id": "py:operator", "name": "运算符与表达式", "phase": "foundation", "difficulty": 1, "blooms": "apply", "hours": 2, "description": "算术/比较/逻辑/赋值运算符、运算符优先级", "keywords": ["运算符", "表达式", "加减乘除", "and", "or", "not"]},
    {"id": "py:flow", "name": "流程控制", "phase": "foundation", "difficulty": 2, "blooms": "apply", "hours": 4, "description": "if-elif-else条件判断、while/for循环、break/continue", "keywords": ["条件判断", "if", "else", "循环", "for", "while", "break", "continue"]},
    {"id": "py:str", "name": "字符串处理", "phase": "foundation", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "字符串索引切片、常用方法、格式化输出、编码", "keywords": ["字符串", "string", "切片", "format", "f-string", "编码", "UTF-8"]},
    {"id": "py:list", "name": "列表与元组", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 4, "description": "列表增删改查、切片、元组不可变性、序列解包", "keywords": ["列表", "list", "元组", "tuple", "切片", "append", "pop", "解包"]},
    {"id": "py:dict", "name": "字典与集合", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 4, "description": "字典键值操作、集合去重与运算、哈希原理", "keywords": ["字典", "dict", "集合", "set", "键值对", "哈希", "去重"]},
    {"id": "py:function", "name": "函数定义与参数", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 5, "description": "def定义、参数类型(位置/关键字/默认/可变)、返回值、作用域LEGB", "keywords": ["函数", "def", "参数", "return", "作用域", "args", "kwargs", "默认参数"]},
    {"id": "py:comprehension", "name": "列表推导式与生成器", "phase": "core", "difficulty": 3, "blooms": "apply", "hours": 3, "description": "列表/字典/集合推导式、生成器表达式、yield关键字", "keywords": ["推导式", "列表推导", "生成器", "generator", "yield", "列表解析"]},
    {"id": "py:file", "name": "文件与IO操作", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "文件读写模式、with上下文管理器、路径处理pathlib", "keywords": ["文件操作", "读写", "open", "with", "pathlib", "IO", "文本文件"]},
    {"id": "py:error", "name": "异常处理", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "try-except-finally、自定义异常、异常链、日志记录", "keywords": ["异常", "try", "except", "raise", "finally", "错误处理", "traceback"]},
    {"id": "py:module", "name": "模块与包管理", "phase": "core", "difficulty": 2, "blooms": "apply", "hours": 3, "description": "import机制、__name__、包结构__init__.py、pip包管理", "keywords": ["模块", "import", "包", "pip", "库", "package", "安装"]},
    {"id": "py:oop_basic", "name": "面向对象基础", "phase": "advanced", "difficulty": 3, "blooms": "apply", "hours": 5, "description": "类与对象、__init__构造、实例方法、属性访问控制", "keywords": ["面向对象", "class", "类", "self", "对象", "OOP", "构造方法", "属性"]},
    {"id": "py:oop_inherit", "name": "继承与多态", "phase": "advanced", "difficulty": 3, "blooms": "analyze", "hours": 5, "description": "单继承/多继承、方法重写、super()、MRO、抽象基类ABC", "keywords": ["继承", "多态", "super", "MRO", "重写", "抽象类", "接口"]},
    {"id": "py:magic", "name": "魔术方法与协议", "phase": "advanced", "difficulty": 4, "blooms": "analyze", "hours": 4, "description": "__str__/__repr__/__eq__/__hash__/__call__、上下文管理器协议", "keywords": ["魔术方法", "dunder", "__str__", "__repr__", "__eq__", "__enter__", "协议"]},
    {"id": "py:decorator", "name": "装饰器", "phase": "advanced", "difficulty": 4, "blooms": "analyze", "hours": 4, "description": "闭包原理、函数装饰器、类装饰器、带参数装饰器、functools.wraps", "keywords": ["装饰器", "decorator", "闭包", "closure", "@", "wraps", "高阶函数"]},
    {"id": "py:iterator", "name": "迭代器与可迭代对象", "phase": "advanced", "difficulty": 3, "blooms": "analyze", "hours": 3, "description": "__iter__/__next__协议、itertools模块、自定义迭代器", "keywords": ["迭代器", "iterator", "iter", "next", "itertools", "可迭代", "Iterable"]},
    {"id": "py:re", "name": "正则表达式", "phase": "advanced", "difficulty": 3, "blooms": "apply", "hours": 4, "description": "re模块、元字符、分组捕获、贪婪/非贪婪、编译优化", "keywords": ["正则表达式", "regex", "re模块", "匹配", "分组", "替换", "查找"]},
    {"id": "py:stdlib", "name": "标准库核心工具", "phase": "advanced", "difficulty": 3, "blooms": "apply", "hours": 5, "description": "datetime时间处理、json/csv序列化、collections容器、random随机", "keywords": ["标准库", "datetime", "json", "csv", "collections", "random", "os"]},
    {"id": "py:type_hints", "name": "类型注解与静态检查", "phase": "advanced", "difficulty": 3, "blooms": "evaluate", "hours": 3, "description": "Type Hints语法、mypy静态检查、TypedDict、Protocol泛型注解", "keywords": ["类型注解", "Type Hints", "mypy", "泛型", "TypedDict", "Protocol", "类型检查"]},
    {"id": "py:async", "name": "异步编程", "phase": "advanced", "difficulty": 4, "blooms": "evaluate", "hours": 5, "description": "async/await语法、事件循环、asyncio核心API、协程vs线程", "keywords": ["异步", "async", "await", "asyncio", "协程", "事件循环", "并发"]},
    {"id": "py:testing", "name": "单元测试与调试", "phase": "practice", "difficulty": 3, "blooms": "evaluate", "hours": 4, "description": "unittest/pytest框架、mock打桩、覆盖率、pdb调试", "keywords": ["测试", "unittest", "pytest", "mock", "调试", "pdb", "覆盖率"]},
    {"id": "py:performance", "name": "性能优化", "phase": "practice", "difficulty": 4, "blooms": "evaluate", "hours": 4, "description": "cProfile性能分析、时间复杂度意识、内存管理、__slots__、对象池", "keywords": ["性能", "优化", "cProfile", "内存", "GIL", "缓存", "profile"]},
    {"id": "py:venv_mgmt", "name": "项目环境管理", "phase": "practice", "difficulty": 2, "blooms": "apply", "hours": 2, "description": "venv/poetry/conda环境隔离、requirements.txt锁定、pyproject.toml", "keywords": ["虚拟环境", "venv", "poetry", "conda", "依赖管理", "pyproject"]},
    {"id": "py:project", "name": "项目结构与工程化", "phase": "practice", "difficulty": 3, "blooms": "create", "hours": 5, "description": "项目目录布局、setup.py/pyproject.toml、打包发布、版本管理、CI/CD基础", "keywords": ["项目结构", "打包", "发布", "setup", "版本", "CI", "工程化"]}
